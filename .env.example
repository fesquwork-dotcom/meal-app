# =============================================================================
# MealApp production environment (Docker Compose)
# Copy to `.env` on the VPS — NEVER commit `.env`
# =============================================================================

# --- Required secrets ---
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
STRATEGY_PREVIEW_SECRET=

# --- Required production settings ---
ENVIRONMENT=production
ALLOW_DEV_AUTH=false
DATABASE_PATH=/data/app.db
ALLOWED_ORIGINS=https://mealapp.ru,https://www.mealapp.ru

# Host path for SQLite persistence (mounted at /data in backend)
MEAL_APP_DATA_PATH=/opt/meal-app-data

# Frontend build: same-origin → browser calls /api on mealapp.ru via proxy
VITE_API_BASE_URL=same-origin

# --- Optional ---
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=16000
PREVIEW_TOKEN_TTL_SECONDS=900
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_AUTH_CLOCK_SKEW_SECONDS=60
APP_VERSION=9.5.0
ADAPTIVE_PREFERENCES=false

# Anthropic HTTP transport:
# false (recommended in production) = do not inherit HTTP_PROXY/HTTPS_PROXY
# true  = honor proxy env vars (local VPN / corporate proxy only)
ANTHROPIC_TRUST_ENV=false

# Do NOT set in production:
# ALLOW_DEV_AUTH=true
# DEV_TELEGRAM_USER_ID=1
# VITE_ENABLE_DIAGNOSTICS=true

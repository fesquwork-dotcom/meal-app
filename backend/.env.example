# Backend environment variables (copy to .env — never commit secrets)

# =============================================================================
# Required (production)
# =============================================================================
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
ALLOWED_ORIGINS=https://frontend.example.com
STRATEGY_PREVIEW_SECRET=
DATABASE_PATH=./app.db
ENVIRONMENT=production
ALLOW_DEV_AUTH=false

# =============================================================================
# Optional
# =============================================================================
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=16000
PREVIEW_TOKEN_TTL_SECONDS=900
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_AUTH_CLOCK_SKEW_SECONDS=60
APP_VERSION=9.5.0
# Adaptive Intelligence: Learned Preferences in Decision when true
ADAPTIVE_PREFERENCES=false
# Deprecated fallback — prefer ANTHROPIC_API_KEY
# CLAUDE_API_KEY=

# =============================================================================
# Development only (never enable with ENVIRONMENT=production)
# =============================================================================
# ALLOW_DEV_AUTH=true
# DEV_TELEGRAM_USER_ID=1
# ENVIRONMENT=development
# ADAPTIVE_PREFERENCES=true
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_PATH=./app.db
# Allow httpx to use HTTP_PROXY / HTTPS_PROXY / system proxy variables.
# Recommended true for local development behind VPN/proxy.
# Default: true in development, false in production.
# ANTHROPIC_TRUST_ENV=true

# =============================================================================
# Production only
# =============================================================================
# ALLOW_DEV_AUTH=false
# ENVIRONMENT=production
# STRATEGY_PREVIEW_SECRET=<random 32+ byte secret>
# DATABASE_PATH=/data/app.db
# Set deliberately according to deployment network policy.
# ANTHROPIC_TRUST_ENV=false

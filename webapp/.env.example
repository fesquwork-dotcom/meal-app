# Frontend environment variables (copy to .env.local — never commit secrets)

# =============================================================================
# Required (production build)
# =============================================================================
VITE_API_BASE_URL=https://api.example.com

# =============================================================================
# Optional / Development
# =============================================================================
# Local Vite defaults to http://localhost:8000 when VITE_API_BASE_URL is unset.
# VITE_API_BASE_URL=http://localhost:8000

# Show /diagnostics outside Vite DEV (keep false in real production)
VITE_ENABLE_DIAGNOSTICS=false
